package-as: Lorebound

# The quest list and the quest pages are add-ons of their own beside Lorebound (both load on demand).
move-folders:
  Lorebound/Lorebound_Data: Lorebound_Data
  Lorebound/Lorebound_Text: Lorebound_Text

manual-changelog:
  filename: RELEASE_NOTES.md
  markup-type: markdown

ignore:
  - tools
  - site
  - sources
  - RELEASE_NOTES.md
  - CHANGELOG.md
  - CURSEFORGE.md
  - README.md
