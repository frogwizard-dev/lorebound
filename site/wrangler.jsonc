{
  // Cloudflare Pages project for lb.frogwizard.net: the static site (public/) and two functions
  // (functions/api/report.js, progress.js). The GitHub token is a secret set in the Pages project, not here.
  // The project and database keep their names from before Loremaster became Lorebound.
  "name": "loremaster-report",
  "pages_build_output_dir": "public",
  "compatibility_date": "2026-11-01",
  "vars": {
    "REPORT_REPO": "frogwizard-dev/loremaster-reports"
  },
  // The rate limit's table: schema.sql.
  "d1_databases": [
    { "binding": "DB", "database_name": "loremaster-report", "database_id": "1762a780-83b2-464f-85fc-9ea8d4df3abd" }
  ]
}
